{
  "name": "ecos-de-valdoria",
  "productName": "Ecos de Valdoria",
  "version": "0.3.3",
  "description": "RPG de fantasÃ­a en 3D",
  "author": "hsanchezlabrin-art",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ecosdevaldoria.juego",
    "productName": "Ecos de Valdoria",
    "copyright": "Ecos de Valdoria",
    "publish": [{ "provider": "github", "owner": "hsanchezlabrin-art", "repo": "ecos-de-valdoria" }],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "splash.html",
      "build/icon.png",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "EcosDeValdoria-Setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.role-playing-games",
      "artifactName": "EcosDeValdoria-Mac.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Ecos de Valdoria",
      "background": "build/dmgBackground.png",
      "icon": "build/icon.png",
      "iconSize": 96,
      "window": { "width": 600, "height": 380 },
      "contents": [
        { "x": 160, "y": 200, "type": "file" },
        { "x": 440, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ecos de Valdoria",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": ["es_ES"],
      "language": "3082"
    }
  }
}
